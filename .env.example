# ==============================================================================
# Переменные окружения для Keramika Sintez (Lamp Sales CRM)
# Скопируйте этот файл в .env и укажите ваши параметры
# ==============================================================================

# 1. Строка подключения к облачной PostgreSQL базе данных (Supabase / Neon / Render)
# Пример для Supabase (Transaction Pooler или Direct URI):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_db_password@db.your_project_id.supabase.co:5432/postgres

# 2. Порт и хост локального сервера (для standalone Node.js)
PORT=3000
HOST=0.0.0.0

# 3. Режим окружения ('development' или 'production')
NODE_ENV=production

# 4. Секретный ключ для подписи сессий
SESSION_SECRET=lamp_crm_secure_session_token_key_change_in_production

# 5. Ограничение доступа по MAC-адресу физического устройства (true только для локальной сети компании)
REQUIRE_DEVICE_MAC=false
