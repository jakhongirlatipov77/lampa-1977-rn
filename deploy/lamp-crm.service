[Unit]
Description=LumiCRM - Lamp Sales and Accounting Web App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/lamp-crm
ExecStart=/usr/bin/node /var/www/lamp-crm/server/server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0

# Лимиты и безопасность
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=lamp-crm

[Install]
WantedBy=multi-user.target
